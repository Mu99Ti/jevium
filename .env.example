TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
TYPESAFE_BASE_URL=https://api.typesafe.ai
# Required for TYPE_TEXT, planner and verifier. OpenAI-compatible helper; credentials stay server-side.
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://openrouter.ai/api/v1
TEXT_MODEL=inception/mercury-2.5
TEXT_MODEL_REASONING=none
PLANNER_MODEL=
JEVIUM_MIN_CONFIDENCE=0.3
# Optional login/payment secrets. Prefer this git-ignored file; a structured
# `username <user> password <pass>` pair in --task is stripped before planning.
# Values are injected only into observed secret fields and never sent to models.
JEVIUM_USERNAME=
JEVIUM_PASSWORD=
JEVIUM_CARD_NUMBER=
JEVIUM_CARD_EXPIRY=
JEVIUM_CARD_CVV=
JEVIUM_CARD_NAME=
